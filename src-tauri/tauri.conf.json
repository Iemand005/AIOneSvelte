{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aione-tauri",
  "version": "0.1.0",
  "identifier": "com.lasse.aione-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AIOne",
        "width": 800,
        "height": 600,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"]
        },
        "additionalBrowserArgs": "--enable-features=msWebView2EnableDraggableRegionSupport,OverlayScrollbar,FluentOverlayScrollbar --disable-features=OverscrollHistoryNavigation,msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
